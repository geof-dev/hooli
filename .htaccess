# For Apache hosting whose document root is the project folder instead of
# public/: every request is served from public/, so nothing else in the
# project (.env, storage, vendor) is reachable from the web. Unused where the
# document root already points at public/ (Herd, nginx).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>
